<Window
    x:Class="YouTube_Video_Downloader.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YouTube_Video_Downloader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:YouTube_Video_Downloader.Views"
    Title="ARTLEXEY's YouTube Video Downloader"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <local:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="10">

            <StackPanel DockPanel.Dock="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox
                            x:Name="InputBox"
                            Height="30"
                            Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="Gray"
                            IsHitTestVisible="False"
                            Text="Paste video or playlist URL">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>
                    </Grid>
                    <Button
                        Grid.Column="1"
                        Width="80"
                        Margin="10,0,0,0"
                        Command="{Binding AddFromUrlCommand}"
                        Content="Add" />
                </Grid>

                <Grid Margin="0,10,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  LEFT SIDE: actions  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Button
                            Margin="0,0,10,0"
                            Padding="10,5"
                            Command="{Binding SelectAllCommand}"
                            Content="Select all" />

                        <Button
                            Margin="0,0,10,0"
                            Padding="10,5"
                            Command="{Binding UnselectAllCommand}"
                            Content="Unselect all" />

                        <Button
                            Margin="0,0,10,0"
                            Padding="10,5"
                            Command="{Binding ClearAllCommand}"
                            Content="Clear all" />

                    </StackPanel>

                    <!--  RIGHT SIDE: preset + download  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <ComboBox
                            Width="180"
                            Margin="0,0,10,0"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            MinWidth="150"
                            Padding="15,5"
                            Command="{Binding DownloadSelectedCommand}"
                            Content="Download selected" />

                    </StackPanel>

                </Grid>

            </StackPanel>

            <DataGrid
                x:Name="DG"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding Videos}"
                SelectionMode="Extended"
                SelectionUnit="FullRow">

                <DataGrid.InputBindings>

                    <!--<KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />

                    <KeyBinding
                        Key="A"
                        Command="{Binding SelectAllCommand}"
                        Modifiers="Control" />-->

                </DataGrid.InputBindings>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">

                        <Setter Property="ContextMenu">

                            <Setter.Value>

                                <ContextMenu>

                                    <MenuItem
                                        Command="{Binding Data.OpenUrlCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}"
                                        Header="Open URL in Browser" />

                                    <MenuItem
                                        Command="{Binding Data.OpenDownloadFolderCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}"
                                        Header="Open Folder" />

                                    <Separator />

                                    <MenuItem
                                        Command="{Binding Data.RemoveVideoCommand, Source={StaticResource VmProxy}, UpdateSourceTrigger=PropertyChanged}"
                                        CommandParameter="{Binding}"
                                        Header="Delete" />

                                </ContextMenu>

                            </Setter.Value>

                        </Setter>

                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTemplateColumn
                        Width="50"
                        Header="✓"
                        SortMemberPath="IsSelected">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Title}"
                        Header="Title"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Author}"
                        Header="Author"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Duration}"
                        Header="Duration"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Status}"
                        Header="Status"
                        SortMemberPath="Status" />

                    <DataGridTemplateColumn
                        Width="200"
                        Header="Progress"
                        SortMemberPath="Progress">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Grid>

                                    <ProgressBar
                                        Height="22"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding Progress}" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Progress, StringFormat={}{0:F0}%}" />

                                </Grid>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>

        <StatusBar Grid.Row="1">

            <StatusBarItem>
                <TextBlock Text="{Binding TotalCount, StringFormat=Total: {0}}" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem>
                <TextBlock Text="{Binding SelectedCount, StringFormat=Selected: {0}}" />
            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>
